  "verified_scopes": {
    "Reuss2015PowerFree": {
      "version": "1307.2802v1,2013authorversion of2015journalwork",
      "scope": "Theorem2;Lemma3statement andselectedproof/unweightedlarge-divisormajorant;Lemma4statementandbeginproof;selected§4chartrelation;§6completefinalsum",
      "summary": "For a fixed irreducible polynomial, the old exponent is d−1. Lemma3 reduces to unweighted squarefree-divisor triples; the final box sum gives a power saving. Ideal and unit balancing plus prime-grid box counting are explicit predecessors. Selected scopes only; prime-input constants differ from ordinary-input factors.",
      "content_checked": true
    },
    "Xiao2017PowerFree": {
      "version": "1505.05587v2;arxivversionheader2017,renderedDate2026observedseparately",
      "scope": "Theorem1.1/definitions1.1-1.4,selectedapplicationparagraph;§9Theorem9.1/definitions9.1-9.2/proof",
      "summary": "The binary-form theorem counts two-variable pairs. Section9 separately reproves Browning’s one-variable result for k≥(3d+1)/4 and bounds an exceptional set using squarefree divisors above B^(1−delta). This supports k=d−2 for d≥9. It does not turn two-variable densities into fixed-line results.",
      "content_checked": true
    },
    "HeathBrown2013Powerfree": {
      "version": "1103.2028v1,2011authorversion of2013journalwork",
      "scope": "Introduction andTheorems1/2statements anddefinitions",
      "summary": "The old theorem concerns irreducible binomials x^d+c with k≥(5d+3)/9 and a power-saving error. It covers k=d−2 for d≥6, not quartic squarefreeness. Prime inputs use a different admissibility condition and local factor.",
      "content_checked": true
    },
    "stacks-project": {
      "version": "sixnamedtagHTMLbodies fetched2026-10-26;pinnedwholefilehashes",
      "scope": "00NQ/02JN/00NB/00NA/031Q/031Rstatement andshortprooftext",
      "summary": "The selected tags give regular-local Cohen–Macaulayness, dimension-drop regular sequences, localization and dimension formula, and the links between no embedded primes, S1, R0 and reducedness. They support the stated complete-intersection criterion under its hypotheses; a boundary calculation is still needed.",
      "content_checked": true
    }
